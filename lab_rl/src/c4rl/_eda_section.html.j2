  <tr><th class="num">Ходов</th><th class="num">Различных позиций</th><th class="num">с точностью до зеркала</th><th class="num">из них партия уже окончена</th></tr>
  {% for r in count_rows %}<tr><td class="num">{{ r.ply }}</td><td class="num">{{ r.total }}</td><td class="num">{{ r.mirror }}</td><td class="num">{{ r.term }}</td></tr>{% endfor %}
</table>
